{
  "name": "pi-strata",
  "version": "0.4.0",
  "description": "Pi, oh-my-pi and DeepSeek Harness extension for Strata: browse the model a Strata server serves, load it, unload it, and see its state.",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "strata",
    "llama-cpp",
    "local-llm",
    "gguf",
    "deepseek-harness",
    "dsh-plugin"
  ],
  "author": "alvaro893",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alvaro893/pi-strata.git"
  },
  "homepage": "https://github.com/alvaro893/pi-strata#readme",
  "bugs": {
    "url": "https://github.com/alvaro893/pi-strata/issues"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md",
    "LICENSE.md"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node test/smoke.mjs",
    "live": "node test/live.mjs",
    "live:dsh": "node test/live-dsh.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jiti": "^2.7.0",
    "typescript": "^5.9.0"
  }
}
